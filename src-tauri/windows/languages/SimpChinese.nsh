; SeekOffer installer copy for Tauri NSIS 2.11.x.
; Keep every Tauri custom LangString in this file: customLanguageFiles replaces
; Tauri's bundled SimpChinese.nsh rather than extending it.
LangString addOrReinstall ${LANG_SIMPCHINESE} "修复或重新安装"
LangString alreadyInstalled ${LANG_SIMPCHINESE} "寻鹿已安装"
LangString alreadyInstalledLong ${LANG_SIMPCHINESE} "此电脑已安装 ${PRODUCTNAME} ${VERSION}。你可以修复当前安装，或安全卸载寻鹿。"
LangString appRunning ${LANG_SIMPCHINESE} "${PRODUCTNAME} 正在运行。请先关闭应用，再继续操作。"
LangString appRunningOkKill ${LANG_SIMPCHINESE} "${PRODUCTNAME} 正在运行。$\n选择“确定”将关闭应用并继续。"
LangString chooseMaintenanceOption ${LANG_SIMPCHINESE} "选择要执行的操作。"
LangString choowHowToInstall ${LANG_SIMPCHINESE} "选择如何完成这次版本变更。"
LangString createDesktop ${LANG_SIMPCHINESE} "在桌面创建寻鹿快捷方式"
LangString dontUninstall ${LANG_SIMPCHINESE} "直接覆盖现有安装"
LangString dontUninstallDowngrade ${LANG_SIMPCHINESE} "保留现有版本（不允许直接降级）"
LangString failedToKillApp ${LANG_SIMPCHINESE} "无法关闭 ${PRODUCTNAME}。请手动关闭应用后重试。"
LangString installingWebview2 ${LANG_SIMPCHINESE} "正在准备 Windows 运行组件…"
LangString newerVersionInstalled ${LANG_SIMPCHINESE} "此电脑已安装更新版本的 ${PRODUCTNAME}。为保护现有数据，不建议安装旧版本。"
LangString older ${LANG_SIMPCHINESE} "较早"
LangString olderOrUnknownVersionInstalled ${LANG_SIMPCHINESE} "此电脑已安装较早版本的 ${PRODUCTNAME}。建议先清理旧程序文件再更新；本机数据与偏好设置会保留。"
LangString silentDowngrades ${LANG_SIMPCHINESE} "静默安装不支持降级。请使用可视化安装程序处理版本变更。$\n"
LangString unableToUninstall ${LANG_SIMPCHINESE} "未能完成卸载。请关闭寻鹿后重试。"
LangString uninstallApp ${LANG_SIMPCHINESE} "卸载寻鹿"
LangString uninstallBeforeInstalling ${LANG_SIMPCHINESE} "清理旧程序文件后安装"
LangString unknown ${LANG_SIMPCHINESE} "未知"
LangString webview2AbortError ${LANG_SIMPCHINESE} "Windows 运行组件安装失败，寻鹿暂时无法启动。请检查网络后重新运行安装程序。"
LangString webview2DownloadError ${LANG_SIMPCHINESE} "Windows 运行组件下载失败：$0"
LangString webview2DownloadSuccess ${LANG_SIMPCHINESE} "Windows 运行组件已下载"
LangString webview2Downloading ${LANG_SIMPCHINESE} "正在下载 Windows 运行组件…"
LangString webview2InstallError ${LANG_SIMPCHINESE} "Windows 运行组件安装失败，错误代码：$1"
LangString webview2InstallSuccess ${LANG_SIMPCHINESE} "Windows 运行组件已就绪"
LangString deleteAppData ${LANG_SIMPCHINESE} "同时删除本机数据与偏好设置"
LangString seekofferPreparing ${LANG_SIMPCHINESE} "正在准备寻鹿应用文件…"
LangString seekofferUpdating ${LANG_SIMPCHINESE} "正在安全更新寻鹿…"
LangString seekofferFinalizing ${LANG_SIMPCHINESE} "正在创建快捷方式并完成安装…"
LangString seekofferUpdateFinalizing ${LANG_SIMPCHINESE} "正在完成更新并保留现有设置…"
LangString seekofferRemoving ${LANG_SIMPCHINESE} "正在移除寻鹿应用文件…"
LangString seekofferWelcomeTitle ${LANG_SIMPCHINESE} "安装寻鹿 SeekOffer"
LangString seekofferWelcomeText ${LANG_SIMPCHINESE} "集中管理保研通知、申请进度与截止提醒。$\r$\n$\r$\n升级或重新安装时，本机数据和偏好设置会保留。点击“下一步”继续。"
LangString seekofferFinishTitle ${LANG_SIMPCHINESE} "寻鹿已准备好"
LangString seekofferFinishText ${LANG_SIMPCHINESE} "安装已完成。你可以立即打开寻鹿，继续管理申请、材料与截止提醒。"
