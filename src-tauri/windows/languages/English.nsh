; SeekOffer installer copy for Tauri NSIS 2.11.x.
; Keep every Tauri custom LangString in this file: customLanguageFiles replaces
; Tauri's bundled English.nsh rather than extending it.
LangString addOrReinstall ${LANG_ENGLISH} "Repair or reinstall"
LangString alreadyInstalled ${LANG_ENGLISH} "SeekOffer is installed"
LangString alreadyInstalledLong ${LANG_ENGLISH} "${PRODUCTNAME} ${VERSION} is already installed on this PC. You can repair the installation or safely remove SeekOffer."
LangString appRunning ${LANG_ENGLISH} "${PRODUCTNAME} is running. Close the app before continuing."
LangString appRunningOkKill ${LANG_ENGLISH} "${PRODUCTNAME} is running.$\nSelect OK to close it and continue."
LangString chooseMaintenanceOption ${LANG_ENGLISH} "Choose what you want to do."
LangString choowHowToInstall ${LANG_ENGLISH} "Choose how to complete this version change."
LangString createDesktop ${LANG_ENGLISH} "Create a SeekOffer desktop shortcut"
LangString dontUninstall ${LANG_ENGLISH} "Install over the existing version"
LangString dontUninstallDowngrade ${LANG_ENGLISH} "Keep the current version (direct downgrade is unavailable)"
LangString failedToKillApp ${LANG_ENGLISH} "SeekOffer could not be closed. Close the app manually and try again."
LangString installingWebview2 ${LANG_ENGLISH} "Preparing Windows runtime components…"
LangString newerVersionInstalled ${LANG_ENGLISH} "A newer version of ${PRODUCTNAME} is already installed. Installing an older version is not recommended."
LangString older ${LANG_ENGLISH} "earlier"
LangString olderOrUnknownVersionInstalled ${LANG_ENGLISH} "An earlier version of ${PRODUCTNAME} is already installed. We recommend removing the old program files before updating; local data and preferences are kept."
LangString silentDowngrades ${LANG_ENGLISH} "Silent installation does not support downgrades. Use the interactive installer to change versions.$\n"
LangString unableToUninstall ${LANG_ENGLISH} "Uninstall could not be completed. Close SeekOffer and try again."
LangString uninstallApp ${LANG_ENGLISH} "Uninstall SeekOffer"
LangString uninstallBeforeInstalling ${LANG_ENGLISH} "Remove old program files, then install"
LangString unknown ${LANG_ENGLISH} "unknown"
LangString webview2AbortError ${LANG_ENGLISH} "The Windows runtime could not be installed, so SeekOffer cannot start yet. Check your network and run Setup again."
LangString webview2DownloadError ${LANG_ENGLISH} "The Windows runtime download failed: $0"
LangString webview2DownloadSuccess ${LANG_ENGLISH} "The Windows runtime has downloaded"
LangString webview2Downloading ${LANG_ENGLISH} "Downloading Windows runtime components…"
LangString webview2InstallError ${LANG_ENGLISH} "The Windows runtime installation failed with error code $1"
LangString webview2InstallSuccess ${LANG_ENGLISH} "The Windows runtime is ready"
LangString deleteAppData ${LANG_ENGLISH} "Also remove local data and preferences"
LangString seekofferPreparing ${LANG_ENGLISH} "Preparing SeekOffer application files…"
LangString seekofferUpdating ${LANG_ENGLISH} "Updating SeekOffer safely…"
LangString seekofferFinalizing ${LANG_ENGLISH} "Creating shortcuts and completing installation…"
LangString seekofferUpdateFinalizing ${LANG_ENGLISH} "Finishing the update and preserving your settings…"
LangString seekofferRemoving ${LANG_ENGLISH} "Removing SeekOffer application files…"
LangString seekofferWelcomeTitle ${LANG_ENGLISH} "Install SeekOffer"
LangString seekofferWelcomeText ${LANG_ENGLISH} "Keep application notices, progress, materials, and deadlines in one place.$\r$\n$\r$\nLocal data and preferences are preserved during upgrades and reinstalls. Select Next to continue."
LangString seekofferFinishTitle ${LANG_ENGLISH} "SeekOffer is ready"
LangString seekofferFinishText ${LANG_ENGLISH} "Installation is complete. Open SeekOffer to continue managing applications, materials, and deadline reminders."
