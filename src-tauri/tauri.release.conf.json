{
  "build": {
    "beforeBuildCommand": ""
  },
  "bundle": {
    "windows": {
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/sign-windows-artifact.ps1",
          "%1"
        ]
      }
    }
  }
}
