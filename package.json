{
  "name": "seekoffer-web",
  "version": "0.2.21",
  "description": "寻鹿 SeekOffer 保研信息与申请管理平台",
  "author": "SeekOffer",
  "homepage": "https://www.seekoffer.com.cn",
  "private": true,
  "scripts": {
    "dev": "cross-env SEEKOFFER_BUILD_TARGET=web NEXT_PUBLIC_SEEKOFFER_SURFACE=web next dev",
    "dev:desktop": "node ./scripts/run-desktop-next.mjs dev",
    "build": "node ./scripts/sync-public-notice-data.mjs && cross-env SEEKOFFER_BUILD_TARGET=web NEXT_PUBLIC_SEEKOFFER_SURFACE=web next build && node ./scripts/verify-build-target-isolation.mjs web .next-web",
    "build:desktop": "node ./scripts/run-desktop-next.mjs build",
    "desktop:auth:verify": "node ./scripts/verify-desktop-auth-export.mjs",
    "desktop": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:compile": "npm run build:desktop && tauri build --no-bundle --config ./src-tauri/tauri.release.conf.json",
    "desktop:bundle": "tauri bundle --bundles nsis --config ./src-tauri/tauri.release.conf.json",
    "desktop:build": "npm run desktop:compile && npm run desktop:bundle",
    "desktop:package": "node ./scripts/package-desktop-release.mjs",
    "desktop:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/invoke-desktop-signed-release.ps1",
    "desktop:release:local-signed": "npm run desktop:release",
    "extension:icons": "node ./scripts/generate-fill-assistant-icons.mjs",
    "extension:check": "node ./scripts/check-fill-assistant-extension.mjs",
    "extension:store-assets": "node ./scripts/generate-fill-assistant-store-assets.mjs",
    "extension:package": "npm run extension:icons && npm run extension:check && node ./scripts/package-fill-assistant-extension.mjs",
    "extension:release": "npm run extension:package && npm run extension:store-assets",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:desktop-release": "vitest run --config vitest.desktop-release.config.ts",
    "test:wechat-digest": "node --test functions/wechat-daily-digest/tests/*.test.mjs",
    "preview:wechat-digest": "node scripts/render-wechat-digest-preview.mjs",
    "wechat:codex:brief": "node scripts/run-wechat-codex-editor.mjs brief",
    "wechat:codex:format": "node scripts/prepare-wechat-baoyu-article.mjs",
    "wechat:codex:publish": "node scripts/run-wechat-codex-editor.mjs publish",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:wechat-digest && npm run audit:admin-security",
    "audit:admin-security": "node ./scripts/audit-admin-security.mjs",
    "start": "next start",
    "cache:logos": "node ./scripts/cache-site-marks.mjs",
    "sync:school-logos": "node ./scripts/sync-urongda-logo-map.mjs",
    "sync:notices": "node ./scripts/sync-public-notice-data.mjs",
    "sync:notices:github": "node ./scripts/sync-baoyan-notices-to-supabase.mjs",
    "seo:submit": "node ./scripts/submit-search-indexing.mjs",
    "import:cloudbase-export": "node ./scripts/import-cloudbase-export-to-supabase.mjs",
    "build:hosting": "npm run build && node ./scripts/prepare-hosting.mjs",
    "deploy:cloudbase": "npm run build:hosting && tcb hosting deploy ./hosting-dist --env-id cloudbase-4gonuep215f23af4"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.316",
    "@supabase/supabase-js": "^2.110.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "lucide-react": "^0.474.0",
    "next": "^15.5.21",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudbase/cli": "3.7.3",
    "@eslint/eslintrc": "^3.3.6",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.7",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
