{
  "name": "seekoffer-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node ./scripts/sync-public-notice-data.mjs && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run audit:admin-security",
    "audit:admin-security": "node ./scripts/audit-admin-security.mjs",
    "start": "next start",
    "cache:logos": "node ./scripts/cache-site-marks.mjs",
    "sync:school-logos": "node ./scripts/sync-urongda-logo-map.mjs",
    "sync:notices": "node ./scripts/sync-public-notice-data.mjs",
    "sync:notices:github": "node ./scripts/sync-baoyan-notices-to-supabase.mjs",
    "seo:submit": "node ./scripts/submit-search-indexing.mjs",
    "import:cloudbase-export": "node ./scripts/import-cloudbase-export-to-supabase.mjs",
    "build:hosting": "npm run build && node ./scripts/prepare-hosting.mjs",
    "deploy:cloudbase": "npm run build:hosting && tcb hosting deploy ./hosting-dist --env-id cloudbase-4gonuep215f23af4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "lucide-react": "^0.474.0",
    "next": "^15.5.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.16",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
