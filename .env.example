# Reviewed community/admin recovery UI; never enables payment processing.
NEXT_PUBLIC_COMMUNITY_RECOVERY=false

# D1 download attempts: enable only with the reviewed Worker budget gate.
NEXT_PUBLIC_DESKTOP_DOWNLOAD_TRACKING_ENABLED=false
# D1 WeChat CLI: no model key is used. Publishing additionally requires private MP + ledger credentials.
SEEKOFFER_DIGEST_PUBLISH_ENABLED=false

# Review + production schema/feature authorization is required before enabling these controls.
NEXT_PUBLIC_ACCOUNT_DELETION_REQUESTS_ENABLED=false
NEXT_PUBLIC_ACCOUNT_DELETION_EXECUTION_ENABLED=false
NEXT_PUBLIC_REFUNDS_ENABLED=false
