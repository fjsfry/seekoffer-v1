WECHAT_DAILY_AUTHOR=寻鹿SeekOffer
WECHAT_DAILY_MAX_CONTENT_CHARS=18000
WECHAT_DAILY_DRY_RUN=false

# Seekoffer Pro / billing
BILLING_MANUAL_ACTIVATION_SECRET=
WECHAT_PAY_APPID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
